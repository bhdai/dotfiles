# Kanagawa Dragon

# Role assignments follow the colorscheme's own extras/fish/kanagawa.fish, with the
# hues swapped for the dragon palette per its themes.lua. The second token on each
# line is the 16-colour fallback for terminals without truecolor.

# Syntax Highlighting Colors
fish_color_normal C5C9C5 normal
fish_color_command 8EA4A2 cyan
fish_color_keyword A292A3 magenta
fish_color_quote C4B28A yellow
fish_color_redirection C5C9C5 normal
fish_color_end B6927B brred
fish_color_option 8992A7 brmagenta
fish_color_error C4746E red
fish_color_param 8992A7 brmagenta
fish_color_comment 737C73 brblack
fish_color_selection --background=2D4F67
fish_color_search_match --background=2D4F67
fish_color_operator 8A9A7B green
fish_color_escape A292A3 magenta
fish_color_autosuggestion 737C73 brblack

# Completion Pager Colors
fish_pager_color_progress 737C73 brblack
fish_pager_color_prefix 8EA4A2 cyan
fish_pager_color_completion C5C9C5 normal
fish_pager_color_description 737C73 brblack
fish_pager_color_selected_background --background=2D4F67
