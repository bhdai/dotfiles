# Everforest dark, hard contrast -- https://github.com/sainnhe/everforest
#
# background is bg0 rather than the darker bg_dim used by Ghostty's bundled
# "Everforest Dark Hard", so the terminal matches what the Neovim colorscheme
# paints and window padding does not show as a border around it.
background = #272e33
foreground = #d3c6aa
cursor-color = #e69875
cursor-text = #272e33
selection-background = #4c3743
selection-foreground = #d3c6aa

# Everforest has no separate bright accents, so 9-14 repeat 1-6 the way the
# Neovim colorscheme sets its terminal palette. Bright black is the exception:
# upstream maps it to bg3 as well, which leaves the dim text that CLI tools draw
# with it unreadable, so it gets grey1 instead.
palette = 0=#414b50
palette = 1=#e67e80
palette = 2=#a7c080
palette = 3=#dbbc7f
palette = 4=#7fbbb3
palette = 5=#d699b6
palette = 6=#83c092
palette = 7=#d3c6aa
palette = 8=#859289
palette = 9=#e67e80
palette = 10=#a7c080
palette = 11=#dbbc7f
palette = 12=#7fbbb3
palette = 13=#d699b6
palette = 14=#83c092
palette = 15=#d3c6aa
